<?xml version="1.0" encoding="utf-8"?><!--
   Everything not excluded here is backed up / transferred. user_data.db (saved games and Trails
   progress) is a few kilobytes and is therefore included; the bundled dictionary is not.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- ~29 MB rebuildable cache copied from assets. Including it exceeds the 25 MB Auto
             Backup quota, which makes the entire backup fail. -->
        <exclude domain="database" path="dictionary_cache.db" />
        <exclude domain="database" path="dictionary_cache.db-wal" />
        <exclude domain="database" path="dictionary_cache.db-shm" />
        <!-- Leftover from the pre-split combined dictionary + user database. -->
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.db-wal" />
        <exclude domain="database" path="dictionary.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="dictionary_cache.db" />
        <exclude domain="database" path="dictionary_cache.db-wal" />
        <exclude domain="database" path="dictionary_cache.db-shm" />
        <exclude domain="database" path="dictionary.db" />
        <exclude domain="database" path="dictionary.db-wal" />
        <exclude domain="database" path="dictionary.db-shm" />
    </device-transfer>
</data-extraction-rules>
