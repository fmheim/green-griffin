<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 30 and below (this app has minSdk 33, so in practice
   res/xml/data_extraction_rules.xml is the file that applies). Kept in sync with it.
-->
<full-backup-content>
    <!-- The dictionary is a ~29 MB rebuildable cache copied from assets; backing it up blows
         the 25 MB Auto Backup quota and makes the whole backup fail. -->
    <exclude domain="database" path="dictionary_cache.db" />
    <exclude domain="database" path="dictionary_cache.db-wal" />
    <exclude domain="database" path="dictionary_cache.db-shm" />
    <!-- Leftover from the pre-split combined dictionary + user database. -->
    <exclude domain="database" path="dictionary.db" />
    <exclude domain="database" path="dictionary.db-wal" />
    <exclude domain="database" path="dictionary.db-shm" />
</full-backup-content>
